# Backend API (optional; default same-origin in dev)
# Vite proxies /api → http://localhost:8000 (see vite.config.js). Start backend with py main.py.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: direct Supabase reads + realtime on the Replies page.
# If unset, the app uses GET /api/replies (needs backend DATABASE_URL + schema).
# End-to-end: backend .env needs SMTP (send), DATABASE_URL (store), IMAP (check inbox).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
